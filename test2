blueprint:
  name: "Brilesa Wheel: Ultimate Final"
  description: "1-Click=On/Off, Double-Click=Individual, Wheel=0-255."
  domain: automation
  input:
    action_sensor:
      name: Wheel Action Sensor
      description: Wybierz sensor akcji (np. sensor.wheel1_action).
      selector:
        entity:
          integration: mqtt
          domain: sensor
    main_lights:
      name: Główne Światła (Cała grupa)
      selector:
        target:
          entity:
            domain: light
    individual_light:
      name: Światło Indywidualne (2-klik)
      selector:
        target:
          entity:
            domain: light

mode: restart

trigger:
  - platform: state
    entity_id: !input action_sensor

action:
  - variables:
      action_state: "{{ trigger.to_state.state }}"
      lvl: "{{ state_attr(trigger.entity_id, 'action_level') | float(0) }}"

  - choose:
      # 1. WHEEL SCROLL
      - conditions:
          - condition: template
            value_template: "{{ action_state == 'brightness_move_to_level' }}"
        sequence:
          - service: light.turn_on
            target: !input main_lights
            data:
              brightness: "{{ lvl }}"

      # 2. SINGLE CLICK ON
      - conditions:
          - condition: template
            value_template: "{{ action_state == 'on' }}"
        sequence:
          - service: light.turn_on
            target: !input main_lights

      # 3. SINGLE CLICK OFF
      - conditions:
          - condition: template
            value_template: "{{ action_state == 'off' }}"
        sequence:
          - service: light.turn_off
            target: !input main_lights

      # 4. DOUBLE CLICK (on_on)
      - conditions:
          - condition: template
            value_template: "{{ action_state in ['double', 'on_on'] }}"
        sequence:
          - service: light.toggle
            target: !input individual_light
